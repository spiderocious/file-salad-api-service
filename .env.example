# Copy to .env and fill in. The server loads .env on start (`go run ./cmd/server`)
# and validates at boot via internal/env — the process refuses to start if
# anything required is missing or malformed.

# development | test | production
NODE_ENV=development

# HTTP port the server listens on
PORT=8080

# trace | debug | info | warn | error
LOG_LEVEL=info

# JWT signing secrets — must be at least 32 characters each.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS allow-origin for the web one-pager. Use * to allow any origin in dev.
WEB_BASE_URL=*

# MongoDB. URI is required; the database name defaults to file_salad.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=file_salad

# Redis (refresh-token sessions + presigned download-URL cache). Required.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (Tigris by default; also works with R2, MinIO,
# AWS S3). Optional in development — when unset, the upload features aren't
# mounted and the server still boots. Endpoint, key, secret, and bucket are all
# required to enable hosted + web uploads. Downloads/public links are presigned
# GETs, so the bucket can be private — no public base URL needed.
#
# Tigris: endpoint https://t3.storage.dev (or https://fly.storage.tigris.dev on
# Fly), region auto, virtual-hosted addressing (the default — leave path-style off).
STORAGE_ENDPOINT=https://t3.storage.dev
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=filesalad
# Set to true only if your provider needs path-style addressing (bucket in the
# path). Leave unset/false for Tigris and modern S3.
STORAGE_USE_PATH_STYLE=false

# Upload tuning.
UPLOAD_URL_TTL=15m            # presigned PUT validity
DOWNLOAD_URL_TTL=1h           # presigned GET validity
MONTHLY_UPLOAD_CAP=50         # hosted free tier + web per-browser cap
MAX_FILE_SIZE_BYTES=52428800  # 50 MB per-file limit
HOSTED_LINK_EXPIRY_DAYS=90    # public link lifetime
SHARE_CODE_TTL=24h            # how long a shareable code stays valid

# Feature flags surfaced to the frontend via GET /api/v1/features.
# Only the literal string "true" counts as on; anything else is off.
FEATURE_SHOULD_SHOW_CODES=false
FEATURE_SHOULD_SUPPORT_BYOK=false
FEATURE_FLAG_TTL=5m           # how long the FE should cache the flag response
